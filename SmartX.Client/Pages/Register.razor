@page "/register"
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http

@* Sensor registration + multipart file upload *@
<PageTitle>Sensors</PageTitle>

<h1>Sensors</h1>
<PartLinks />
<p class="lede">Register a node with MAC, location, and category. Attach an encrypted log or photo.</p>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card mesh-card">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">MAC address</label>
                    <input class="form-control" @bind="request.MacAddress" placeholder="24:6F:28:AA:BB:CC" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <input class="form-control" @bind="request.DisplayName" placeholder="Gutter probe" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Deployment location</label>
                    <input class="form-control" @bind="request.Location"
                           placeholder="Facility A -> Zone 1 -> Sub-Zone B" />
                    <small class="text-muted">Must match the campus tree, e.g. Facility A -&gt; Zone 1 -&gt; Sub-Zone B</small>
                </div>
                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select class="form-select" @bind="categoryName">
                        <option value="Environmental">Environmental</option>
                        <option value="PowerConsumption">Power Consumption</option>
                        <option value="Actuator">Actuator</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Log or photo</label>
                    <InputFile class="form-control" OnChange="OnFileSelected" />
                    <small class="text-muted">@fileName</small>
                </div>
                <button class="btn btn-success" @onclick="SubmitForm" disabled="@busy">Register</button>
                <p class="mt-3 mb-0 @(ok ? "text-success" : "text-danger")">@message</p>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card mesh-card">
            <div class="card-header">Registered (@sensors.Count)</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>MAC</th>
                            <th>Category</th>
                            <th>Files</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sensor in sensors)
                        {
                            <tr>
                                <td>@sensor.DisplayName</td>
                                <td>@sensor.MacAddress</td>
                                <td>@sensor.Category</td>
                                <td>@(sensor.Attachments.Count == 0 ? "—" : $"{sensor.Attachments.Count} AES")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly Regex MacPattern = new(@"^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$", RegexOptions.Compiled);
    private readonly SensorRegistrationRequest request = new()
    {
        MacAddress = "24:6F:28:99:00:01",
        DisplayName = "Spare probe",
        Location = "Facility A -> Zone 1 -> Sub-Zone B",
        Category = SensorCategory.Environmental
    };
    private string categoryName = nameof(SensorCategory.Environmental);
    private IBrowserFile? selectedFile;
    private string fileName = "Optional · max 10 MB";
    private string message = "";
    private bool ok;
    private bool busy;
    private List<SensorProfile> sensors = [];

    protected override async Task OnInitializedAsync() => await LoadSensors();

    private async Task LoadSensors()
    {
        try
        {
            sensors = await Http.GetFromJsonAsync<List<SensorProfile>>("/api/sensors") ?? [];
        }
        catch
        {
            ok = false;
            message = "Cannot reach the API.";
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        fileName = selectedFile.Size > 10 * 1024 * 1024
            ? "File too large (max 10 MB)"
            : selectedFile.Name;
        if (selectedFile.Size > 10 * 1024 * 1024)
        {
            selectedFile = null;
        }
    }

    private async Task SubmitForm()
    {
        if (!MacPattern.IsMatch(request.MacAddress.Trim()))
        {
            ok = false;
            message = "MAC must look like 24:6F:28:AA:BB:CC.";
            return;
        }

        if (string.IsNullOrWhiteSpace(request.Location))
        {
            ok = false;
            message = "Location is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(request.DisplayName))
        {
            ok = false;
            message = "Name is required.";
            return;
        }

        busy = true;
        request.Category = Enum.Parse<SensorCategory>(categoryName);
        try
        {
            var response = await Http.PostAsJsonAsync("/api/sensors/register", request);
            var body = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode)
            {
                ok = false;
                message = "Location is not valid for this category.";
                return;
            }

            ok = true;
            message = "Sensor saved.";
            if (selectedFile is not null)
            {
                using var content = new MultipartFormDataContent();
                var fileContent = new StreamContent(selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
                content.Add(fileContent, "file", selectedFile.Name);
                var upload = await Http.PostAsync($"/api/sensors/{request.MacAddress}/upload", content);
                message = upload.IsSuccessStatusCode ? "Sensor saved. File encrypted on disk." : "Sensor saved. File upload failed.";
                ok = upload.IsSuccessStatusCode;
            }

            await LoadSensors();
        }
        finally
        {
            busy = false;
        }
    }
}
